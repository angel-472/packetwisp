{
  "name": "packetwisp",
  "version": "1.0.0",
  "description": "Schema-driven binary packets for WebSockets. Describe your packet once, send 16 bytes instead of 93.",
  "license": "ISC",
  "author": "angel-472",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/example.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "example": "tsx src/example.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "npm run bench:size && npm run bench:speed",
    "bench:size": "tsx scripts/benchmark-size.ts",
    "bench:speed": "tsx scripts/benchmark-speed.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tinybench": "^6.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "websocket",
    "binary",
    "serialization",
    "packet",
    "schema",
    "arraybuffer",
    "gamedev",
    "multiplayer",
    "netcode",
    "bitpacking"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angel-472/packetwisp.git"
  },
  "bugs": {
    "url": "https://github.com/angel-472/packetwisp/issues"
  },
  "homepage": "https://github.com/angel-472/packetwisp#readme"
}
